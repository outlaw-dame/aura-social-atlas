# Public origin of this gateway (its ActivityPub actor lives at <origin>/actor).
GATEWAY_ORIGIN=https://gateway.example.com

# PostgreSQL connection string (durable subscriptions, items, keys, dedup).
DATABASE_URL=postgres://user:password@db-host:5432/discovery_gateway

# Admin API bearer token. Generate with: openssl rand -hex 32
# NEVER put this in the Atlas frontend or any client bundle.
GATEWAY_ADMIN_TOKEN=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the public read API cross-origin
# (your Atlas deployment(s)). Empty = same-origin only.
GATEWAY_CORS_ORIGINS=https://atlas.example.com

# Optional tuning (defaults shown):
# PORT=4100
# GATEWAY_MAX_BODY_BYTES=1048576
# GATEWAY_MAX_REDIRECTS=3
# GATEWAY_FETCH_TIMEOUT_MS=10000
# GATEWAY_MAX_ITEMS=50000
# GATEWAY_MAX_TEXT_LENGTH=4000
# GATEWAY_READ_RATE_LIMIT=120
# GATEWAY_ADMIN_RATE_LIMIT=30
# GATEWAY_FEDERATION_RATE_LIMIT=600
