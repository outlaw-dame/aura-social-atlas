# Atlas optional ActivityPub relay — one instance per protocol, each on its OWN origin.
# Copy to .env on the relay host only. Never commit real values.

# "mastodon" (Mastodon-style, subscribe via shared inbox) or "litepub" (Pleroma/Akkoma/Bonfire-style, follow the relay actor)
RELAY_PROTOCOL=mastodon

# Bare https origin, no path. Must be different for each protocol instance.
RELAY_ORIGIN=https://relay-mastodon.example.com

# Comma-separated exact hostnames allowed to subscribe and publish. Required; no wildcards, no subdomains.
RELAY_ALLOWED_DOMAINS=fedizen.net

# Durable PostgreSQL for keys, followers and the delivery queue. Use a separate database (or schema) per instance.
DATABASE_URL=postgres://relay_user:CHANGE_ME@db.internal:5432/relay_mastodon

# Optional limits (validated; startup fails if out of range)
PORT=8787                       # 1–65535
RELAY_MAX_BODY_BYTES=1000000    # 1024–10000000
RELAY_FETCH_TIMEOUT_MS=10000    # 1000–60000
RELAY_MAX_REDIRECTS=3           # 0–5

# Local testing only: in-memory stores and http://localhost origin. Never in production.
# RELAY_DEV_MEMORY=1
